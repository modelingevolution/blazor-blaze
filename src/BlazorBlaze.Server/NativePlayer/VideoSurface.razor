@using Microsoft.Extensions.Logging
@using Microsoft.JSInterop
@using ModelingEvolution.EventAggregator
@implements IAsyncDisposable
@inject IKioskDetector KioskDetector
@inject IEventAggregator EventAggregator
@inject IJSRuntime JsRuntime
@inject ILogger<VideoSurface> Logger

@if (KioskDetector.IsKiosk)
{
    <div @ref="_placeholderRef"
         style="visibility:hidden; opacity:0; @PlaceholderSizeStyle @Style">
    </div>
}
else
{
    <img src="@StreamUrl" style="@Style" class="@Class" alt="@Alt" />
}

@code {
    private static int _nextId;

    private ElementReference _placeholderRef;
    private IJSObjectReference? _jsModule;
    private IJSObjectReference? _jsAdapter;
    private DotNetObjectReference<VideoSurface>? _selfRef;
    private string _resolvedPlayerId = string.Empty;

    [Parameter, EditorRequired]
    public string StreamUrl { get; set; } = default!;

    [Parameter]
    public string? PlayerId { get; set; }

    [Parameter]
    public int Width { get; set; } = 1920;

    [Parameter]
    public int Height { get; set; } = 1080;

    [Parameter]
    public string? Style { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public string Alt { get; set; } = "Video stream";

    /// <summary>
    /// Native player background color override. Published as a BackgroundColorChanged
    /// EA event on init. Not restored on dispose (background is global, owned by host).
    /// </summary>
    [Parameter]
    public string? BackgroundColor { get; set; }

    /// <summary>
    /// Source-frame width/height that the AI inference operates on. When 0, falls back
    /// to <see cref="Width"/>/<see cref="Height"/>. Native player uses this together
    /// with <see cref="RoiX"/>..<see cref="RoiHeight"/> to position overlays.
    /// </summary>
    [Parameter] public int FrameWidth { get; set; }
    [Parameter] public int FrameHeight { get; set; }

    /// <summary>
    /// AI ROI in source-frame coordinates. When all four are 0 the full frame is used.
    /// </summary>
    [Parameter] public int RoiX { get; set; }
    [Parameter] public int RoiY { get; set; }
    [Parameter] public int RoiWidth { get; set; }
    [Parameter] public int RoiHeight { get; set; }

    /// <summary>
    /// Fill mode: the kiosk placeholder fits inside its container in both axes while preserving the
    /// <see cref="FrameWidth"/>/<see cref="FrameHeight"/> aspect ratio (fit-contain) instead of using
    /// fixed pixels, while still painting no opaque pixels and starting no browser poll (FR-6).
    /// </summary>
    [Parameter] public bool Fill { get; set; }

    private int ResolvedFrameWidth => FrameWidth > 0 ? FrameWidth : Width;
    private int ResolvedFrameHeight => FrameHeight > 0 ? FrameHeight : Height;

    private string PlaceholderSizeStyle => Fill
        ? $"aspect-ratio:{ResolvedFrameWidth} / {ResolvedFrameHeight}; max-width:100%; max-height:100%;"
        : $"width:{Width}px; height:{Height}px;";

    protected override void OnInitialized()
    {
        _resolvedPlayerId = PlayerId ?? $"vs-{Interlocked.Increment(ref _nextId)}";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !KioskDetector.IsKiosk)
            return;

        _selfRef = DotNetObjectReference.Create(this);

        _jsModule = await JsRuntime.InvokeAsync<IJSObjectReference>(
            "import", VideoSurfaceConstants.ModulePath);

        _jsAdapter = await _jsModule.InvokeAsync<IJSObjectReference>(
            "createAdapter", _placeholderRef, _resolvedPlayerId, _selfRef);

        var rect = await _jsAdapter.InvokeAsync<PlayerRect>("getRect");

        if (BackgroundColor is not null)
        {
            await EventAggregator.GetEvent<BackgroundColorChanged>()
                .Publish(new BackgroundColorChanged(BackgroundColor));
        }

        var fw = ResolvedFrameWidth;
        var fh = ResolvedFrameHeight;
        var rw = RoiWidth  > 0 ? RoiWidth  : fw;
        var rh = RoiHeight > 0 ? RoiHeight : fh;

        await EventAggregator.GetEvent<PlayerInitialized>().Publish(
            new PlayerInitialized(_resolvedPlayerId, StreamUrl, rect.X, rect.Y, rect.Width, rect.Height,
                                  fw, fh, RoiX, RoiY, rw, rh));

        await EventAggregator.GetEvent<PlayRequested>()
            .Publish(new PlayRequested(_resolvedPlayerId));
    }

    /// <summary>
    /// Publishes the current zoom/pan viewport state to the native player (design §5). The host owns
    /// the <c>(scale, nPanX, nPanY)</c> state (nPanX/nPanY NORMALIZED: tx/clipW, ty/clipH); this stamps
    /// the resolved player id and emits a <see cref="ViewportChanged"/> event. Kiosk-only — in browser
    /// mode the host applies the transform itself and there is no native consumer.
    /// </summary>
    public Task PublishViewportAsync(double scale, double nPanX, double nPanY)
    {
        if (!KioskDetector.IsKiosk)
            return Task.CompletedTask;

        return EventAggregator.GetEvent<ViewportChanged>()
            .Publish(new ViewportChanged(_resolvedPlayerId, scale, nPanX, nPanY));
    }

    [JSInvokable]
    public Task OnRectChanged(int x, int y, int width, int height)
    {
        return EventAggregator.GetEvent<LayoutChanged>()
            .Publish(new LayoutChanged(_resolvedPlayerId, x, y, width, height));
    }

    public async ValueTask DisposeAsync()
    {
        if (!KioskDetector.IsKiosk)
        {
            _selfRef?.Dispose();
            _selfRef = null;
            return;
        }

        try
        {
            await EventAggregator.GetEvent<PlayerDestroyed>().Publish(new PlayerDestroyed(_resolvedPlayerId));
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "VideoSurface {PlayerId}: PlayerDestroyed publish failed during dispose", _resolvedPlayerId);
        }

        if (_jsAdapter is null)
        {
            _selfRef?.Dispose();
            _selfRef = null;
            return;
        }

        try
        {
            await _jsAdapter.InvokeVoidAsync("dispose");
        }
        catch (JSDisconnectedException ex)
        {
            Logger.LogDebug(ex, "VideoSurface {PlayerId}: circuit disconnected during dispose", _resolvedPlayerId);
        }
        catch (OperationCanceledException ex)
        {
            Logger.LogDebug(ex, "VideoSurface {PlayerId}: JS call cancelled during dispose", _resolvedPlayerId);
        }
        catch (InvalidOperationException ex)
        {
            Logger.LogDebug(ex, "VideoSurface {PlayerId}: JS runtime unavailable during dispose", _resolvedPlayerId);
        }

        try
        {
            if (_jsAdapter is not null)
                await _jsAdapter.DisposeAsync();
            if (_jsModule is not null)
                await _jsModule.DisposeAsync();
        }
        catch (JSDisconnectedException ex)
        {
            Logger.LogDebug(ex, "VideoSurface {PlayerId}: circuit disconnected during JS cleanup", _resolvedPlayerId);
        }
        catch (OperationCanceledException ex)
        {
            Logger.LogDebug(ex, "VideoSurface {PlayerId}: JS call cancelled during JS cleanup", _resolvedPlayerId);
        }
        catch (InvalidOperationException ex)
        {
            Logger.LogDebug(ex, "VideoSurface {PlayerId}: JS runtime unavailable during JS cleanup", _resolvedPlayerId);
        }

        _selfRef?.Dispose();
        _selfRef = null;
    }
}
