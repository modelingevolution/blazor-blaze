@using Microsoft.Extensions.Logging
@using Microsoft.JSInterop
@using ModelingEvolution.EventAggregator
@implements IAsyncDisposable
@inject IKioskDetector KioskDetector
@inject IEventAggregator EventAggregator
@inject IJSRuntime JsRuntime
@inject ILogger<VideoSurface> Logger

@if (KioskDetector.IsNativePlayer)
{
    <div @ref="_placeholderRef" data-np-video
         style="visibility:hidden; opacity:0; @PlaceholderSizeStyle @Style">
    </div>
}
else
{
    <img src="@StreamUrl" style="@Style" class="@Class" alt="@Alt" />
}

@code {
    private static int _nextId;

    private ElementReference _placeholderRef;
    private IJSObjectReference? _jsModule;
    private IJSObjectReference? _jsAdapter;
    private DotNetObjectReference<VideoSurface>? _selfRef;
    private string _resolvedPlayerId = string.Empty;
    private bool _creatingAdapter;
    private bool _adapterFailureLogged;
    private bool _disposed;

    [Parameter, EditorRequired]
    public string StreamUrl { get; set; } = default!;

    /// <summary>
    /// Optional native-player source address (e.g. <c>shm://cam0</c>) for the kiosk path only.
    /// When set, the kiosk <see cref="PlayerInitialized"/> publishes this instead of <see cref="StreamUrl"/>
    /// as the primary URL, and also carries <see cref="StreamUrl"/> as its MJPEG fallback (a remote kiosk
    /// cannot resolve a host-local shm source, so it can fall back to MJPEG); the browser <c>&lt;img&gt;</c>
    /// always uses <see cref="StreamUrl"/> and is never given this address (FR-12).
    /// When null the kiosk path falls back to <see cref="StreamUrl"/>, byte-for-byte today's behavior (FR-14).
    /// </summary>
    [Parameter]
    public string? NativeStreamUrl { get; set; }

    [Parameter]
    public string? PlayerId { get; set; }

    [Parameter]
    public int Width { get; set; } = 1920;

    [Parameter]
    public int Height { get; set; } = 1080;

    [Parameter]
    public string? Style { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public string Alt { get; set; } = "Video stream";

    /// <summary>
    /// Native player background color override. Published as a BackgroundColorChanged
    /// EA event on init. Not restored on dispose (background is global, owned by host).
    /// </summary>
    [Parameter]
    public string? BackgroundColor { get; set; }

    /// <summary>
    /// Source-frame width/height that the AI inference operates on. When 0, falls back
    /// to <see cref="Width"/>/<see cref="Height"/>. Native player uses this together
    /// with <see cref="RoiX"/>..<see cref="RoiHeight"/> to position overlays.
    /// </summary>
    [Parameter] public int FrameWidth { get; set; }
    [Parameter] public int FrameHeight { get; set; }

    /// <summary>
    /// AI ROI in source-frame coordinates. When all four are 0 the full frame is used.
    /// </summary>
    [Parameter] public int RoiX { get; set; }
    [Parameter] public int RoiY { get; set; }
    [Parameter] public int RoiWidth { get; set; }
    [Parameter] public int RoiHeight { get; set; }

    /// <summary>
    /// Fill mode: the kiosk placeholder fits inside its container in both axes while preserving the
    /// <see cref="FrameWidth"/>/<see cref="FrameHeight"/> aspect ratio (fit-contain) instead of using
    /// fixed pixels, while still painting no opaque pixels and starting no browser poll (FR-6).
    /// </summary>
    [Parameter] public bool Fill { get; set; }

    private int ResolvedFrameWidth => FrameWidth > 0 ? FrameWidth : Width;
    private int ResolvedFrameHeight => FrameHeight > 0 ? FrameHeight : Height;

    private string PlaceholderSizeStyle => Fill
        ? $"aspect-ratio:{ResolvedFrameWidth} / {ResolvedFrameHeight}; max-width:100%; max-height:100%;"
        : $"width:{Width}px; height:{Height}px;";

    protected override void OnInitialized()
    {
        _resolvedPlayerId = PlayerId ?? $"vs-{Interlocked.Increment(ref _nextId)}";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Bug 075: every render of THIS component until an adapter exists, not only the first. A failed or
        // element-less creation is retried on the surface's own next render (a parameter change); a parent render
        // with unchanged parameters does not re-render it. A surface whose element is gone is in practice being
        // removed: it is disposed, and the instance that replaces it creates its adapter on its first render.
        if (!KioskDetector.IsNativePlayer || _jsAdapter is not null || _creatingAdapter || _disposed)
            return;

        PlayerRect rect;
        _creatingAdapter = true;
        try
        {
            var created = await TryCreateAdapterAsync();
            if (created is null)
                return;
            (_jsAdapter, rect) = created.Value;
        }
        finally
        {
            _creatingAdapter = false;
        }

        if (_disposed)
            return; // DisposeAsync published PlayerDestroyed and released the adapter: nothing after it.

        if (BackgroundColor is not null)
        {
            await EventAggregator.GetEvent<BackgroundColorChanged>()
                .Publish(new BackgroundColorChanged(BackgroundColor));
        }

        var fw = ResolvedFrameWidth;
        var fh = ResolvedFrameHeight;
        var rw = RoiWidth  > 0 ? RoiWidth  : fw;
        var rh = RoiHeight > 0 ? RoiHeight : fh;

        var usingNativeStreamUrl = !string.IsNullOrWhiteSpace(NativeStreamUrl);
        var nativeUrl = usingNativeStreamUrl ? NativeStreamUrl! : StreamUrl;

        if (string.IsNullOrWhiteSpace(nativeUrl))
        {
            Logger.LogDebug(
                "VideoSurface {PlayerId}: skipping PlayerInitialized — no valid source (NativeStreamUrl and StreamUrl both blank); keeping existing player source",
                _resolvedPlayerId);
            return;
        }

        var fallbackUrl = usingNativeStreamUrl && !string.IsNullOrWhiteSpace(StreamUrl) ? StreamUrl : null;

        if (_disposed)
            return;

        await EventAggregator.GetEvent<PlayerInitialized>().Publish(
            new PlayerInitialized(_resolvedPlayerId, nativeUrl, rect.X, rect.Y, rect.Width, rect.Height,
                                  fw, fh, RoiX, RoiY, rw, rh, fallbackUrl));

        if (_disposed)
            return;

        await EventAggregator.GetEvent<PlayRequested>()
            .Publish(new PlayRequested(_resolvedPlayerId));
    }

    /// <summary>
    /// Bug 075: creates the JS adapter for the placeholder and reads its first rect. Returns null when there is no
    /// adapter yet: the element is not in the DOM (video-surface.js returns no adapter), or the JS call failed
    /// (element or circuit gone). Such a failure never escapes OnAfterRenderAsync, where it would kill the Blazor
    /// Server circuit; it is logged once as a warning and the surface's next own render tries again.
    /// Each await is a window in which STATION STOP can dispose the component, so <see cref="_disposed"/> is
    /// re-checked after each one, and whatever arrived for a disposed component is released here, because
    /// DisposeAsync has already run and cannot see it.
    /// </summary>
    private async Task<(IJSObjectReference Adapter, PlayerRect Rect)?> TryCreateAdapterAsync()
    {
        IJSObjectReference? adapter = null;
        try
        {
            _selfRef ??= DotNetObjectReference.Create(this);
            if (_jsModule is null)
            {
                var module = await JsRuntime.InvokeAsync<IJSObjectReference>(
                    "import", VideoSurfaceConstants.ModulePath);
                if (_disposed)
                {
                    await DisposeOrphanAsync(module, isAdapter: false);
                    return null;
                }
                _jsModule = module;
            }

            adapter = await _jsModule.InvokeAsync<IJSObjectReference?>(
                "createAdapter", _placeholderRef, _resolvedPlayerId, _selfRef);
            if (adapter is null)
            {
                Logger.LogDebug(
                    "VideoSurface {PlayerId}: placeholder element is not in the DOM; adapter will be created on a later render",
                    _resolvedPlayerId);
                return null;
            }

            if (_disposed)
            {
                // Removed while createAdapter was in flight: the adapter would keep tracking a dead element.
                await DisposeOrphanAsync(adapter, isAdapter: true);
                return null;
            }

            var rect = await adapter.InvokeAsync<PlayerRect>("getRect");
            if (_disposed)
            {
                // Removed while getRect was in flight (PR #26 review F1): same as above, and no PlayerInitialized.
                await DisposeOrphanAsync(adapter, isAdapter: true);
                return null;
            }
            return (adapter, rect);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or OperationCanceledException)
        {
            if (!_adapterFailureLogged)
            {
                _adapterFailureLogged = true;
                Logger.LogWarning(ex,
                    "VideoSurface {PlayerId}: creating the video adapter failed; the video slot stays blank and is retried on the next render",
                    _resolvedPlayerId);
            }
            else
            {
                Logger.LogDebug(ex, "VideoSurface {PlayerId}: creating the video adapter failed again", _resolvedPlayerId);
            }

            if (adapter is not null)
                await DisposeOrphanAsync(adapter, isAdapter: true);
            return null;
        }
    }

    /// <summary>Releases a JS object this component no longer keeps: an adapter also gets its JS <c>dispose</c>
    /// (it clears html.np-video, bug 590); the module reference is only released.</summary>
    private async Task DisposeOrphanAsync(IJSObjectReference reference, bool isAdapter)
    {
        try
        {
            if (isAdapter)
                await reference.InvokeVoidAsync("dispose");
            await reference.DisposeAsync();
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or OperationCanceledException)
        {
            Logger.LogDebug(ex, "VideoSurface {PlayerId}: releasing an unused JS object failed", _resolvedPlayerId);
        }
    }

    /// <summary>
    /// Publishes the current zoom/pan viewport state to the native player (design §5). The host owns
    /// the <c>(scale, nPanX, nPanY)</c> state (nPanX/nPanY NORMALIZED: tx/clipW, ty/clipH); this stamps
    /// the resolved player id and emits a <see cref="ViewportChanged"/> event. Kiosk-only — in browser
    /// mode the host applies the transform itself and there is no native consumer.
    /// </summary>
    public Task PublishViewportAsync(double scale, double nPanX, double nPanY)
    {
        if (!KioskDetector.IsNativePlayer)
            return Task.CompletedTask;

        return EventAggregator.GetEvent<ViewportChanged>()
            .Publish(new ViewportChanged(_resolvedPlayerId, scale, nPanX, nPanY));
    }

    [JSInvokable]
    public Task OnRectChanged(int x, int y, int width, int height)
    {
        return EventAggregator.GetEvent<LayoutChanged>()
            .Publish(new LayoutChanged(_resolvedPlayerId, x, y, width, height));
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;

        if (!KioskDetector.IsNativePlayer)
        {
            _selfRef?.Dispose();
            _selfRef = null;
            return;
        }

        try
        {
            await EventAggregator.GetEvent<PlayerDestroyed>().Publish(new PlayerDestroyed(_resolvedPlayerId));
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "VideoSurface {PlayerId}: PlayerDestroyed publish failed during dispose", _resolvedPlayerId);
        }

        // Bug 075: the adapter may never have been created (element gone) while the module was imported;
        // the module reference is still released below.
        if (_jsAdapter is not null)
        {
            try
            {
                await _jsAdapter.InvokeVoidAsync("dispose");
            }
            catch (JSDisconnectedException ex)
            {
                Logger.LogDebug(ex, "VideoSurface {PlayerId}: circuit disconnected during dispose", _resolvedPlayerId);
            }
            catch (JSException ex)
            {
                // Bug 075: the adapter's JS dispose failed (its element is gone); nothing may escape DisposeAsync.
                Logger.LogDebug(ex, "VideoSurface {PlayerId}: JS adapter dispose failed", _resolvedPlayerId);
            }
            catch (OperationCanceledException ex)
            {
                Logger.LogDebug(ex, "VideoSurface {PlayerId}: JS call cancelled during dispose", _resolvedPlayerId);
            }
            catch (InvalidOperationException ex)
            {
                Logger.LogDebug(ex, "VideoSurface {PlayerId}: JS runtime unavailable during dispose", _resolvedPlayerId);
            }
        }

        try
        {
            if (_jsAdapter is not null)
                await _jsAdapter.DisposeAsync();
            if (_jsModule is not null)
                await _jsModule.DisposeAsync();
        }
        catch (JSDisconnectedException ex)
        {
            Logger.LogDebug(ex, "VideoSurface {PlayerId}: circuit disconnected during JS cleanup", _resolvedPlayerId);
        }
        catch (JSException ex)
        {
            Logger.LogDebug(ex, "VideoSurface {PlayerId}: releasing a JS reference failed during JS cleanup", _resolvedPlayerId);
        }
        catch (OperationCanceledException ex)
        {
            Logger.LogDebug(ex, "VideoSurface {PlayerId}: JS call cancelled during JS cleanup", _resolvedPlayerId);
        }
        catch (InvalidOperationException ex)
        {
            Logger.LogDebug(ex, "VideoSurface {PlayerId}: JS runtime unavailable during JS cleanup", _resolvedPlayerId);
        }

        _selfRef?.Dispose();
        _selfRef = null;
    }
}
